<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>SlayMyStats.Probe</RootNamespace>
        <AssemblyName>SlayMyStatsProbe</AssemblyName>
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <!-- The very code the mod runs, so what the probe proves about uploading holds for the mod. -->
    <ItemGroup>
        <Compile Include="..\SlayMyStatsCode\Uploader.cs" Link="Uploader.cs"/>
        <Compile Include="..\SlayMyStatsCode\SteamTicket.cs" Link="SteamTicket.cs"/>
        <Compile Include="..\SlayMyStatsCode\UploadSettings.cs" Link="UploadSettings.cs"/>
        <Compile Include="..\SlayMyStatsCode\ModConfig.cs" Link="ModConfig.cs"/>
        <Compile Include="..\SlayMyStatsCode\CheckpointFile.cs" Link="CheckpointFile.cs"/>
        <Compile Include="..\SlayMyStatsCode\EventLog.cs" Link="EventLog.cs"/>
        <Compile Include="..\SlayMyStatsCode\RunHealth.cs" Link="RunHealth.cs"/>
        <Compile Include="..\SlayMyStatsCode\ConfigEditor.cs" Link="ConfigEditor.cs"/>
        <Compile Include="..\SlayMyStatsCode\DisplaySettings.cs" Link="DisplaySettings.cs"/>
        <Compile Include="..\SlayMyStatsCode\PackData.cs" Link="PackData.cs"/>
        <Compile Include="..\SlayMyStatsCode\PackStore.cs" Link="PackStore.cs"/>
        <Compile Include="..\SlayMyStatsCode\Ruler.cs" Link="Ruler.cs"/>
        <Compile Include="..\SlayMyStatsCode\Rates.cs" Link="Rates.cs"/>
        <Compile Include="..\SlayMyStatsCode\EventRates.cs" Link="EventRates.cs"/>
        <Compile Include="..\SlayMyStatsCode\Strength.cs" Link="Strength.cs"/>
        <Compile Include="..\SlayMyStatsCode\Synergy.cs" Link="Synergy.cs"/>
    </ItemGroup>

    <!-- Outside the game nothing is loaded yet, so the probe carries its own copies of the game's Steam libraries. -->
    <ItemGroup>
        <Reference Include="Steamworks.NET">
            <HintPath>$(Sts2DataDir)/Steamworks.NET.dll</HintPath>
        </Reference>
        <None Include="$(Sts2DataDir)/steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Visible="false"/>
        <None Include="steam_appid.txt" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
